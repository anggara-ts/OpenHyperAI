# Per-game console logs written by Util/split-console.js (big, and they carry the host's Steam ID)
Util/match-logs/
# Generated by the Util scripts
Util/role-weights/rows.json
Util/hero-review/hero-review.html
Util/meta-builds/heroes/
# Fretbots / Buff plugin files copied in by the plugin installer (branch plugin-fretbots)
FretBots/
FretBots.lua
Buff/
Customize/fretbots.lua
# In-game verification tracker (Util/verify.js): local test state, quotes match-log lines
Util/verify/
# Build info for the game's version line (Util/build-info.js, run by the git hooks)
Customize/build_info.lua
# Local secrets for the Util/ tools (API tokens). Template: .env.example
.env
